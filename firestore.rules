rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 사용자 정보: 본인만 읽기/쓰기
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid;
    }

    // 영상: 본인만 CRUD. 공개 공유는 필드를 선별하는 서버 페이지를 통해 제공한다.
    match /videos/{videoId} {
      allow read, delete: if ownsDocument();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;

      // 메모 서브컬렉션: 영상 소유자만 CRUD
      match /memos/{memoId} {
        allow read, create, update, delete: if isSignedIn()
          && get(/databases/$(database)/documents/videos/$(videoId)).data.userId == request.auth.uid;
      }
    }

    // 컬렉션: 본인만 CRUD
    match /collections/{colId} {
      allow read, delete: if ownsDocument();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }
  }
}
