# Firebase 클라이언트 공개 설정 (Vercel Config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 서버 전용: 서비스 계정 JSON 전체를 Base64로 인코딩한 한 줄 값 (Vercel Secret)
# Base64는 암호화가 아닙니다. 원본 JSON과 인코딩한 값을 커밋하지 마세요.
FIREBASE_ADMIN_SDK=
# 관리자 Firebase UID 1개. 이메일이나 쉼표로 구분한 목록이 아닙니다.
# 미설정 시 관리자 접근을 거부합니다. ADMIN_UIDS는 사용하지 않습니다.
ADMIN_UID=

# YouTube Data API v3 (서버 전용, Vercel Secret)
YOUTUBE_API_KEY=

# 서비스 배포 URL (SEO, sitemap, OG 태그에 사용)
NEXT_PUBLIC_BASE_URL=

# Naver Site Verification
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Kakao AdFit (선택, 비워두면 광고 배너를 렌더링하지 않음)
# AdFit 콘솔 → 광고단위 관리 → 광고단위 코드 (DAN-으로 시작)
NEXT_PUBLIC_ADFIT_UNIT=
